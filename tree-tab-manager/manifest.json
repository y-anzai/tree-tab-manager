{
  "manifest_version": 3,
  "name": "Tree Tab Manager",
  "version": "1.0.0",
  "description": "タブをツリー形式で管理するサイドバー拡張機能",
  "permissions": [
    "tabs",
    "tabGroups",
    "history",
    "bookmarks",
    "storage",
    "sessions",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tree Tab Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
